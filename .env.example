# General
NODE_ENV=development
APP_ENV=development

# Deposit/payment feature flags
DEPOSIT_EXTERNAL_ENABLED=false
DEPOSIT_DEMO_ENABLED=false
PAYMENT_PROVIDER_MODE=mock
PAYMENT_SIMULATOR_ENABLED=true

# Deposit limits (adjust to your own test policy)
DEPOSIT_MIN_AMOUNT=1
DEPOSIT_MAX_AMOUNT=100000
DEPOSIT_DAILY_LIMIT=200000
DEPOSIT_MONTHLY_LIMIT=1000000
DEPOSIT_FEE_RATE_BPS=0
DEPOSIT_FIXED_FEE=0
DEPOSIT_LIMIT_TIMEZONE=Asia/Dhaka

# bKash sandbox (enable only with official sandbox credentials)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=https://your-public-test-domain.example/api/v1/deposits/bkash/callback

# Stripe card payments (Visa/Mastercard credit/debit through Stripe Checkout)
# For test mode use an sk_test_... key. Do not use sk_live during development.
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://your-frontend.example/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://your-frontend.example/payment/cancel
STRIPE_TIMEOUT_MS=30000

# Mobile providers: local simulator supports BKASH/NAGAD/ROCKET in mock mode.
# Real Nagad/Rocket adapters require provider-issued merchant sandbox credentials
# and their current official API contract; no live keys should be placed here until approved.
